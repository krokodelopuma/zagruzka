int main(void)
{
  /* USER CODE BEGIN 1 */

  /* USER CODE END 1 */

  HAL_Init();

  /* USER CODE BEGIN Init */

  /* USER CODE END Init */

  SystemClock_Config();

  /* USER CODE BEGIN SysInit */

  /* USER CODE END SysInit */

  MX_GPIO_Init();
  
  /* USER CODE BEGIN 2 */

  /* Инициализация пинов через мой драйвер */
  /* 1 = OUTPUT, 0 = INPUT */
  /* 0 = No pull, 1 = Pull-up */
  My_GPIO_Init(GPIOD, GPIO_PIN_13, 1, 0); 
  My_GPIO_Init(GPIOD, GPIO_PIN_14, 1, 0);
  My_GPIO_Init(GPIOD, GPIO_PIN_15, 1, 0);
  My_GPIO_Init(GPIOC, GPIO_PIN_15, 0, 1); // Кнопка на вход с подтяжкой

  reset_input();
  state = STATE_INPUT;

  /* USER CODE END 2 */

  /* USER CODE BEGIN WHILE */
  while (1)
  {
    uint32_t now = HAL_GetTick();

    if (state == STATE_INPUT)
    {
        uint8_t evt = button_poll();

        if (evt == 1 || evt == 2) {
            handle_element(evt == 1 ? 0 : 1);
        }

        update_indicators();

        if (entered_len > 0 && (now - input_start >= INPUT_TIMEOUT_MS)) {
            state       = STATE_TIMEOUT;
            state_start = now;
        }
    }
    else if (state == STATE_OPENED)
    {
        led_green(1);

        if (now - state_start >= GREEN_HOLD_MS) {
            led_green(0);
            reset_input();
            state = STATE_INPUT;
        }
    }
    else if (state == STATE_ALARM)
    {
        if (now - state_start >= RED_ALARM_MS) {
            led_red(0);
            reset_input();
            state = STATE_INPUT;
        } else {
            led_red((uint8_t)(((now - state_start) / BLINK_MS) & 1));
        }
    }
    else if (state == STATE_TIMEOUT)
    {
        if (now - state_start < 1000) {
            led_yellow(1);
        } else {
            led_yellow(0);
            reset_input();
            state = STATE_INPUT;
        }
    }
  }
  /* USER CODE END 3 */
}

