#define CODE_LENGTH          8
#define LONG_PRESS_MS        1000
#define GREEN_HOLD_MS        3000
#define RED_ALARM_MS         5000
#define INPUT_TIMEOUT_MS     10000
#define MAX_FAILS            3
#define BLINK_MS             150
#define DEBOUNCE_MS          20

/* USER CODE END PD */

