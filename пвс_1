/* СОБСТВЕННЫЙ ДРАЙВЕР GPIO*/

void My_GPIO_Init(GPIO_TypeDef *GPIOx, uint16_t pin, uint32_t mode, uint32_t pull)
{
    if (GPIOx == GPIOA) __HAL_RCC_GPIOA_CLK_ENABLE();
    if (GPIOx == GPIOB) __HAL_RCC_GPIOB_CLK_ENABLE();
    if (GPIOx == GPIOC) __HAL_RCC_GPIOC_CLK_ENABLE();
    if (GPIOx == GPIOD) __HAL_RCC_GPIOD_CLK_ENABLE();

    uint32_t pin_pos = 0;
    while (!((pin >> pin_pos) & 1)) pin_pos++;

    GPIOx->MODER &= ~(3U << (pin_pos * 2));
    GPIOx->MODER |= (mode << (pin_pos * 2));

    GPIOx->PUPDR &= ~(3U << (pin_pos * 2));
    GPIOx->PUPDR |= (pull << (pin_pos * 2));
}

void My_GPIO_WritePin(GPIO_TypeDef *GPIOx, uint16_t pin, uint8_t state)
{
    if (state) {
        GPIOx->BSRR = pin;
    } else {
        GPIOx->BSRR = (pin << 16);
    }
}

uint8_t My_GPIO_ReadPin(GPIO_TypeDef *GPIOx, uint16_t pin)
{
    return (GPIOx->IDR & pin) ? 1 : 0;
}

void My_GPIO_WritePort(GPIO_TypeDef *GPIOx, uint16_t mask, uint16_t data)
{
    uint32_t odr = GPIOx->ODR;
    GPIOx->BSRR = ((odr & mask) << 16) | (data & mask); 
}


/* --- ФУНКЦИИ ИНДИКАЦИИ --- */

static void leds_off(void)
{
    My_GPIO_WritePin(GPIOD, GPIO_PIN_13 | GPIO_PIN_14 | GPIO_PIN_15, 0);
}

static void led_green(uint8_t on)
{
    My_GPIO_WritePin(GPIOD, GPIO_PIN_13, on);
}

static void led_yellow(uint8_t on)
{
    My_GPIO_WritePin(GPIOD, GPIO_PIN_14, on);
}

static void led_red(uint8_t on)
{
    My_GPIO_WritePin(GPIOD, GPIO_PIN_15, on);
}

static uint8_t button_poll(void)
{
    uint8_t  raw = !My_GPIO_ReadPin(GPIOC, GPIO_PIN_15);
    uint32_t now = HAL_GetTick();

    switch (btn_state)
    {
    case BTN_RELEASED:
        if (raw) { btn_state = BTN_DEBOUNCE_PRESS; btn_time = now; }
        break;

    case BTN_DEBOUNCE_PRESS:
        if (!raw) { btn_state = BTN_RELEASED; }
        else if (now - btn_time >= DEBOUNCE_MS) {
            btn_state   = BTN_PRESSED;
            press_start = now;
        }
        break;

    case BTN_PRESSED:
        if (!raw) { btn_state = BTN_DEBOUNCE_RELEASE; btn_time = now; }
        else if (now - press_start >= LONG_PRESS_MS) {
            btn_state = BTN_LONG_SENT;
            return 2;
        }
        break;

    case BTN_DEBOUNCE_RELEASE:
        if (raw) { btn_state = BTN_PRESSED; }
        else if (now - btn_time >= DEBOUNCE_MS) {
            btn_state = BTN_RELEASED;
            return 1;
        }
        break;

    case BTN_LONG_SENT:
        if (!raw) {
            btn_state = BTN_RELEASED;
        }
        break;
    }
    return 0;
}

static void reset_input(void)
{
    entered_len = 0;
    input_start = HAL_GetTick();
    leds_off();
    yellow_ticks = 0;
    red_ticks    = 0;
}

static void start_blink_yellow(uint8_t times)
{
    yellow_ticks = (uint8_t)(times * 2);
    red_ticks    = 0;
    phase_start  = HAL_GetTick();
}

static void start_blink_red(uint8_t times)
{
    red_ticks    = (uint8_t)(times * 2);
    yellow_ticks = 0;
    phase_start  = HAL_GetTick();
}

static void update_indicators(void)
{
    uint32_t now = HAL_GetTick();

    if (yellow_ticks) {
        if (now - phase_start >= BLINK_MS) {
            phase_start = now;
            yellow_ticks--;
            led_yellow(yellow_ticks & 1);
        }
    }
    if (red_ticks) {
        if (now - phase_start >= BLINK_MS) {
            phase_start = now;
            red_ticks--;
            led_red(red_ticks & 1);
        }
    }
}

static void handle_element(uint8_t value)
{
    if (state != STATE_INPUT) {
        return;
    }

    if (value == secret_code[entered_len]) {
        entered[entered_len] = value;
        entered_len++;

        if (entered_len >= CODE_LENGTH) {
            yellow_ticks = 0;
            red_ticks    = 0;
            leds_off();
            led_green(1);
            state        = STATE_OPENED;
            state_start  = HAL_GetTick();
            entered_len  = 0;
            fail_count   = 0;
            return;
        }

        start_blink_yellow(1);
    } else {
        start_blink_red(1);
        fail_count++;
        entered_len = 0;
        input_start = HAL_GetTick();

        if (fail_count >= MAX_FAILS) {
            state       = STATE_ALARM;
            state_start = HAL_GetTick();
            fail_count  = 0;
        }
    }
}
