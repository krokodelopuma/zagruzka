static const uint8_t secret_code[CODE_LENGTH] = {0, 0, 0, 0, 0, 0, 1, 0};

static lock_state_t state = STATE_INPUT;

static uint8_t  entered[CODE_LENGTH];
static uint8_t  entered_len = 0;
static uint8_t  fail_count  = 0;
static uint32_t input_start = 0;

static uint8_t  yellow_ticks = 0;
static uint8_t  red_ticks    = 0;
static uint32_t phase_start  = 0;
static uint32_t state_start  = 0;

static btn_state_t btn_state   = BTN_RELEASED;
static uint32_t    btn_time    = 0;
