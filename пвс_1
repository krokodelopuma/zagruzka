    STATE_INPUT = 0,
    STATE_OPENED,
    STATE_ALARM,
    STATE_TIMEOUT
} lock_state_t;

typedef enum {
    BTN_RELEASED = 0,
    BTN_DEBOUNCE_PRESS,
    BTN_PRESSED,
    BTN_DEBOUNCE_RELEASE,
    BTN_LONG_SENT
} btn_state_t;

